  "captions": [
    {"id":"c01","sceneId":"scene-01","text":"Warum vergisst deine KI plötzlich etwas, das du ihr vorher geschrieben hast?","startFrame":8,"endFrame":150,"lineCount":2,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c02","sceneId":"scene-01","text":"Der Grund ist meistens ihr Kontextfenster.","startFrame":150,"endFrame":220,"lineCount":1,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c03","sceneId":"scene-02","text":"Stell dir den Chat wie ein langes Band vor.","startFrame":245,"endFrame":330,"lineCount":1,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c04","sceneId":"scene-02","text":"Die KI sieht nicht das gesamte Band, sondern nur einen begrenzten Ausschnitt.","startFrame":330,"endFrame":465,"lineCount":2,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c05","sceneId":"scene-03","text":"Mit jeder neuen Nachricht wandert dieses Fenster weiter.","startFrame":488,"endFrame":700,"lineCount":1,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c06","sceneId":"scene-04","text":"Ältere Teile rutschen irgendwann hinaus.","startFrame":728,"endFrame":830,"lineCount":1,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c07","sceneId":"scene-04","text":"Für die nächste Antwort stehen sie nicht mehr vollständig zur Verfügung.","startFrame":830,"endFrame":945,"lineCount":2,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c08","sceneId":"scene-05","text":"Besonders schnell passiert das bei langen Texten und vielen Dateien.","startFrame":968,"endFrame":1080,"lineCount":2,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c09","sceneId":"scene-05","text":"Auch sehr ausführliche Antworten füllen das Fenster schnell.","startFrame":1080,"endFrame":1185,"lineCount":1,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c10","sceneId":"scene-06","text":"Dann fehlen plötzlich Namen, Regeln oder Entscheidungen vom Anfang.","startFrame":1208,"endFrame":1420,"lineCount":2,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c11","sceneId":"scene-07","text":"Fasse wichtige Punkte regelmäßig kurz zusammen und wiederhole zentrale Vorgaben.","startFrame":1448,"endFrame":1555,"lineCount":2,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c12","sceneId":"scene-07","text":"Teile große Projekte in klare Abschnitte und speichere Entscheidungen außerhalb des Chats.","startFrame":1555,"endFrame":1665,"lineCount":2,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c13","sceneId":"scene-08","text":"So gibst du der KI genau den Kontext, den sie gerade braucht.","startFrame":1688,"endFrame":1768,"lineCount":2,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c14","sceneId":"scene-08","text":"Sie hat dich nicht absichtlich vergessen.","startFrame":1768,"endFrame":1818,"lineCount":1,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"},
    {"id":"c15","sceneId":"scene-08","text":"Der relevante Teil war nur nicht mehr im sichtbaren Fenster.","startFrame":1818,"endFrame":1860,"lineCount":2,"bottomPx":220,"revealMode":"instant","wordHighlight":false,"progressIndicator":"single-violet-line"}
