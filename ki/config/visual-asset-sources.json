{
  "version": 3,
  "status": "CURATED_VISUAL_SOURCE_POLICY",
  "policy": {
    "remoteMediaDuringRender": false,
    "googleImageSearchAsLicenseAuthority": false,
    "productionNeedsResolvedLocalFile": true,
    "preferRightsWithoutRequiredOnScreenCredit": true,
    "preferredOrder": [
      "NATIVE_UI",
      "OFFICIAL_SOURCE_CARD",
      "WIKIMEDIA_COMMONS",
      "GITHUB_RAW"
    ],
    "externalRealVisualGuideline": {
      "idealMin": 1,
      "idealMax": 2,
      "defaultHardMax": 2,
      "zeroAllowedWhenNoExplanatoryValue": true,
      "overrideField": "reel.visuals.maxExternalBinaries",
      "principle": "One or two strong real visual moments are preferred over generic stock filler; native UI remains the base layer."
    }
  },
  "providers": {
    "WIKIMEDIA_COMMONS": {
      "enabled": true,
      "api": "https://commons.wikimedia.org/w/api.php",
      "requiresApiKey": false,
      "acceptedRights": ["CC0-1.0", "PUBLIC_DOMAIN", "CC-BY-4.0"],
      "requiresAttributionFor": ["CC-BY-4.0"],
      "defaultSelection": {
        "minimumLongEdge": 1200,
        "minimumShortEdge": 700,
        "preferredOrientation": "AUTO",
        "mediaIntent": "PHOTO_OR_REAL_VISUAL",
        "preferPublicDomainOrCC0": true,
        "candidateLimit": 20
      },
      "notes": "Search and file metadata come from Wikimedia Commons. Candidates are license-filtered and then deterministically ranked by relevance, resolution, crop suitability and rights status before download."
    },
    "GITHUB_RAW": {
      "enabled": true,
      "requiresApiKey": false,
      "acceptedRights": ["CC0-1.0", "PUBLIC_DOMAIN", "CC-BY-4.0", "MIT", "Apache-2.0"],
      "requirements": [
        "exact raw/blob URL",
        "pinned repository commit SHA",
        "declared license",
        "license source URL"
      ],
      "notes": "No repository-wide license guessing. The manifest must explicitly pin the commit and license evidence."
    }
  }
}
