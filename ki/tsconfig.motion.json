{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/index.ts",
    "src/Root.tsx",
    "src/ProductionRoot.tsx",
    "src/production-entry.tsx",
    "src/motion/**/*.ts",
    "src/motion-system/**/*.ts",
    "src/motion-system/**/*.tsx",
    "src/motion-system/**/*.json",
    "src/reels/**/*.ts",
    "src/reels/**/*.tsx",
    "src/longform/**/*.ts",
    "src/longform/**/*.tsx",
    "reels/**/*.json"
  ],
  "exclude": [
    "src/longform/ai-app-workflow/Visuals.tsx"
  ]
}
