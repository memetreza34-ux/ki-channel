{
  "version": 1,
  "fps": 30,
  "cues": [
    {"sceneId":"semantic-01","startFrame":0,"endFrame":60,"text":"Du suchst nach einer Antwort,"},
    {"sceneId":"semantic-01","startFrame":60,"endFrame":120,"text":"aber die beste Fundstelle benutzt"},
    {"sceneId":"semantic-01","startFrame":120,"endFrame":180,"text":"vielleicht ganz andere Wörter."},
    {"sceneId":"semantic-01","startFrame":180,"endFrame":240,"text":"Eine semantische Suche kann sie"},
    {"sceneId":"semantic-01","startFrame":240,"endFrame":300,"text":"trotzdem finden, weil sie nicht"},
    {"sceneId":"semantic-01","startFrame":300,"endFrame":360,"text":"nur Wortgleichheit vergleicht."},

    {"sceneId":"semantic-02","startFrame":360,"endFrame":415,"text":"Dafür werden Texte oft in"},
    {"sceneId":"semantic-02","startFrame":415,"endFrame":470,"text":"sogenannte Embeddings verwandelt."},
    {"sceneId":"semantic-02","startFrame":470,"endFrame":525,"text":"Ein Embedding ist ein Vektor,"},
    {"sceneId":"semantic-02","startFrame":525,"endFrame":580,"text":"also eine Liste von Zahlen,"},
    {"sceneId":"semantic-02","startFrame":580,"endFrame":635,"text":"die ein Modell aus dem"},
    {"sceneId":"semantic-02","startFrame":635,"endFrame":690,"text":"Text erzeugt."},

    {"sceneId":"semantic-03","startFrame":690,"endFrame":750,"text":"Texte, die inhaltlich stärker zusammenhängen,"},
    {"sceneId":"semantic-03","startFrame":750,"endFrame":810,"text":"können dadurch im Vektorraum näher"},
    {"sceneId":"semantic-03","startFrame":810,"endFrame":870,"text":"beieinander liegen. Deshalb kann eine"},
    {"sceneId":"semantic-03","startFrame":870,"endFrame":930,"text":"Frage zu einem Thema auch"},
    {"sceneId":"semantic-03","startFrame":930,"endFrame":990,"text":"Formulierungen finden, die kaum dieselben"},
    {"sceneId":"semantic-03","startFrame":990,"endFrame":1050,"text":"Wörter benutzen."},

    {"sceneId":"semantic-04","startFrame":1050,"endFrame":1110,"text":"Bei der Suche wird auch"},
    {"sceneId":"semantic-04","startFrame":1110,"endFrame":1170,"text":"deine Anfrage eingebettet."},
    {"sceneId":"semantic-04","startFrame":1170,"endFrame":1230,"text":"Das System vergleicht ihren Vektor"},
    {"sceneId":"semantic-04","startFrame":1230,"endFrame":1290,"text":"mit gespeicherten Vektoren und ordnet"},
    {"sceneId":"semantic-04","startFrame":1290,"endFrame":1350,"text":"Treffer nach Ähnlichkeit, zum Beispiel"},
    {"sceneId":"semantic-04","startFrame":1350,"endFrame":1410,"text":"mit Kosinusähnlichkeit."},

    {"sceneId":"semantic-05","startFrame":1410,"endFrame":1459,"text":"Embeddings werden deshalb für Suche,"},
    {"sceneId":"semantic-05","startFrame":1459,"endFrame":1508,"text":"Clustering und Empfehlungen genutzt."},
    {"sceneId":"semantic-05","startFrame":1508,"endFrame":1557,"text":"Wichtig: Unsere Punktwolke ist nur"},
    {"sceneId":"semantic-05","startFrame":1557,"endFrame":1606,"text":"eine vereinfachte 2D-Darstellung."},
    {"sceneId":"semantic-05","startFrame":1606,"endFrame":1655,"text":"Nähe bedeutet modellierte Ähnlichkeit,"},
    {"sceneId":"semantic-05","startFrame":1655,"endFrame":1704,"text":"nicht automatisch Wahrheit."},
    {"sceneId":"semantic-05","startFrame":1704,"endFrame":1753,"text":"Der Vorteil bleibt: Bedeutung kann"},
    {"sceneId":"semantic-05","startFrame":1753,"endFrame":1800,"text":"wichtiger sein als identische Wörter."}
  ]
}
