{
  "version": 2,
  "status": "PREVIEW_ONLY_ALIGNMENT_REQUIRED",
  "cues": [
    {"id":"c01","sceneId":"scene1","sentenceId":"s01","startFrame":0,"endFrame":70,"text":"Grok Bot kann jetzt direkt"},
    {"id":"c02","sceneId":"scene1","sentenceId":"s01","startFrame":70,"endFrame":120,"text":"mit X arbeiten —"},
    {"id":"c03","sceneId":"scene1","sentenceId":"s01","startFrame":120,"endFrame":180,"text":"und das ist mehr als"},
    {"id":"c04","sceneId":"scene1","sentenceId":"s01","startFrame":180,"endFrame":235,"text":"nur ein neuer Connector."},
    {"id":"c05","sceneId":"scene1","sentenceId":"s02","startFrame":235,"endFrame":280,"text":"Du meldest dein X-Konto"},
    {"id":"c06","sceneId":"scene1","sentenceId":"s02","startFrame":280,"endFrame":330,"text":"in Grok Bot an."},
    {"id":"c07","sceneId":"scene2","sentenceId":"s03","startFrame":330,"endFrame":390,"text":"Falls dir noch ein"},
    {"id":"c08","sceneId":"scene2","sentenceId":"s03","startFrame":390,"endFrame":455,"text":"Developer-Account fehlt, soll beim"},
    {"id":"c09","sceneId":"scene2","sentenceId":"s03","startFrame":455,"endFrame":515,"text":"Verbinden automatisch einer erstellt werden."},
    {"id":"c10","sceneId":"scene2","sentenceId":"s04","startFrame":515,"endFrame":595,"text":"Bezahlte Grok-Bot-Nutzer bekommen außerdem"},
    {"id":"c11","sceneId":"scene2","sentenceId":"s04","startFrame":595,"endFrame":690,"text":"kostenlose X-API-Credits zum Start."},
    {"id":"c12","sceneId":"scene3","sentenceId":"s05","startFrame":690,"endFrame":755,"text":"Danach kann ein Bot Posts"},
    {"id":"c13","sceneId":"scene3","sentenceId":"s05","startFrame":755,"endFrame":815,"text":"suchen, deine Timeline lesen,"},
    {"id":"c14","sceneId":"scene3","sentenceId":"s05","startFrame":815,"endFrame":875,"text":"Erwähnungen prüfen und zusammenfassen,"},
    {"id":"c15","sceneId":"scene3","sentenceId":"s05","startFrame":875,"endFrame":935,"text":"was gerade auf X passiert."},
    {"id":"c16","sceneId":"scene3","sentenceId":"s06","startFrame":935,"endFrame":1010,"text":"Zusätzlich gibt es ein X-Plugin"},
    {"id":"c17","sceneId":"scene3","sentenceId":"s06","startFrame":1010,"endFrame":1110,"text":"für Trends und Bookmarks."},
    {"id":"c18","sceneId":"scene4","sentenceId":"s07","startFrame":1110,"endFrame":1170,"text":"Der wichtige Punkt: Grok Bot"},
    {"id":"c19","sceneId":"scene4","sentenceId":"s07","startFrame":1170,"endFrame":1230,"text":"ist nicht nur ein Chat."},
    {"id":"c20","sceneId":"scene4","sentenceId":"s08","startFrame":1230,"endFrame":1285,"text":"Jeder Bot arbeitet auf"},
    {"id":"c21","sceneId":"scene4","sentenceId":"s08","startFrame":1285,"endFrame":1340,"text":"einem persistenten Cloud-Computer mit"},
    {"id":"c22","sceneId":"scene4","sentenceId":"s08","startFrame":1340,"endFrame":1395,"text":"Browser, Dateisystem und Terminal"},
    {"id":"c23","sceneId":"scene4","sentenceId":"s08","startFrame":1395,"endFrame":1450,"text":"und kann Aufgaben in"},
    {"id":"c24","sceneId":"scene4","sentenceId":"s08","startFrame":1450,"endFrame":1505,"text":"echten Tools ausführen."},
    {"id":"c25","sceneId":"scene4","sentenceId":"s09","startFrame":1505,"endFrame":1533,"text":"Damit wird X für solche"},
    {"id":"c26","sceneId":"scene4","sentenceId":"s09","startFrame":1533,"endFrame":1562,"text":"Bots eher zu einer Arbeitsquelle"},
    {"id":"c27","sceneId":"scene4","sentenceId":"s09","startFrame":1562,"endFrame":1590,"text":"als nur zu einem Feed."},
    {"id":"c28","sceneId":"scene5","sentenceId":"s10","startFrame":1590,"endFrame":1655,"text":"Praktisch könntest du einen Bot"},
    {"id":"c29","sceneId":"scene5","sentenceId":"s10","startFrame":1655,"endFrame":1715,"text":"zum Beispiel täglich relevante Posts,"},
    {"id":"c30","sceneId":"scene5","sentenceId":"s10","startFrame":1715,"endFrame":1770,"text":"Erwähnungen und Trends sammeln lassen."},
    {"id":"c31","sceneId":"scene5","sentenceId":"s11","startFrame":1770,"endFrame":1810,"text":"Aber: Laut offizieller Ankündigung"},
    {"id":"c32","sceneId":"scene5","sentenceId":"s11","startFrame":1810,"endFrame":1848,"text":"ist das die erste Version"},
    {"id":"c33","sceneId":"scene5","sentenceId":"s11","startFrame":1848,"endFrame":1878,"text":"der Integration."},
    {"id":"c34","sceneId":"scene5","sentenceId":"s12","startFrame":1878,"endFrame":1898,"text":"Wie gut und zuverlässig"},
    {"id":"c35","sceneId":"scene5","sentenceId":"s12","startFrame":1898,"endFrame":1916,"text":"solche automatisierten X-Workflows"},
    {"id":"c36","sceneId":"scene5","sentenceId":"s12","startFrame":1916,"endFrame":1933,"text":"im Alltag funktionieren,"},
    {"id":"c37","sceneId":"scene5","sentenceId":"s12","startFrame":1933,"endFrame":1950,"text":"muss sich also noch zeigen."}
  ]
}
