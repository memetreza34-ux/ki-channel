  "cues": [
    {"id":"c01","sceneId":"scene1","sentenceId":"s01","startFrame":0,"endFrame":55,"text":"Anthropic hat zwei neue"},
    {"id":"c02","sceneId":"scene1","sentenceId":"s01","startFrame":55,"endFrame":115,"text":"Claude-Modelle veröffentlicht: Fable 5.1"},
    {"id":"c03","sceneId":"scene1","sentenceId":"s01","startFrame":115,"endFrame":165,"text":"und Mythos 5.1."},
    {"id":"c04","sceneId":"scene1","sentenceId":"s02","startFrame":165,"endFrame":220,"text":"Das Spannende ist: Laut Anthropic"},
    {"id":"c05","sceneId":"scene1","sentenceId":"s02","startFrame":220,"endFrame":275,"text":"basieren beide auf demselben"},
    {"id":"c06","sceneId":"scene1","sentenceId":"s02","startFrame":275,"endFrame":330,"text":"zugrunde liegenden Modell."},

    {"id":"c07","sceneId":"scene2","sentenceId":"s03","startFrame":330,"endFrame":385,"text":"Der Unterschied liegt vor allem"},
    {"id":"c08","sceneId":"scene2","sentenceId":"s03","startFrame":385,"endFrame":440,"text":"darin, wer welche Fähigkeiten"},
    {"id":"c09","sceneId":"scene2","sentenceId":"s03","startFrame":440,"endFrame":480,"text":"nutzen darf."},
    {"id":"c10","sceneId":"scene2","sentenceId":"s04","startFrame":480,"endFrame":525,"text":"Fable 5.1 ist für"},
    {"id":"c11","sceneId":"scene2","sentenceId":"s04","startFrame":525,"endFrame":575,"text":"Pro, Max, Team und Enterprise"},
    {"id":"c12","sceneId":"scene2","sentenceId":"s04","startFrame":575,"endFrame":625,"text":"verfügbar und kommt auch"},
    {"id":"c13","sceneId":"scene2","sentenceId":"s04","startFrame":625,"endFrame":690,"text":"über API, AWS, Google Cloud"},

    {"id":"c14","sceneId":"scene3","sentenceId":"s04","startFrame":690,"endFrame":735,"text":"und Microsoft Foundry."},
    {"id":"c15","sceneId":"scene3","sentenceId":"s05","startFrame":735,"endFrame":790,"text":"Mythos 5.1 bleibt dagegen"},
    {"id":"c16","sceneId":"scene3","sentenceId":"s05","startFrame":790,"endFrame":850,"text":"nur für geprüfte Organisationen"},
    {"id":"c17","sceneId":"scene3","sentenceId":"s05","startFrame":850,"endFrame":905,"text":"in Trusted-Access-Programmen offen."},
    {"id":"c18","sceneId":"scene3","sentenceId":"s06","startFrame":905,"endFrame":945,"text":"Warum? Anthropic sagt,"},
    {"id":"c19","sceneId":"scene3","sentenceId":"s06","startFrame":945,"endFrame":1005,"text":"dass die Fähigkeiten in Cybersecurity"},
    {"id":"c20","sceneId":"scene3","sentenceId":"s06","startFrame":1005,"endFrame":1060,"text":"und Biologie so weit gehen,"},
    {"id":"c21","sceneId":"scene3","sentenceId":"s06","startFrame":1060,"endFrame":1110,"text":"dass Schutzmaßnahmen nötig sind."},

    {"id":"c22","sceneId":"scene4","sentenceId":"s07","startFrame":1110,"endFrame":1170,"text":"Fable 5.1 bekommt deshalb"},
    {"id":"c23","sceneId":"scene4","sentenceId":"s07","startFrame":1170,"endFrame":1235,"text":"stärkere Grenzen, Mythos 5.1"},
    {"id":"c24","sceneId":"scene4","sentenceId":"s07","startFrame":1235,"endFrame":1295,"text":"behält mehr Hochrisiko-Fähigkeiten."},
    {"id":"c25","sceneId":"scene4","sentenceId":"s08","startFrame":1295,"endFrame":1350,"text":"Preislich liegt Fable 5.1"},
    {"id":"c26","sceneId":"scene4","sentenceId":"s08","startFrame":1350,"endFrame":1410,"text":"bei zehn Dollar pro Million"},
    {"id":"c27","sceneId":"scene4","sentenceId":"s08","startFrame":1410,"endFrame":1470,"text":"Input-Tokens und fünfzig Dollar"},
    {"id":"c28","sceneId":"scene4","sentenceId":"s08","startFrame":1470,"endFrame":1530,"text":"pro Million Output-Tokens."},

    {"id":"c29","sceneId":"scene5","sentenceId":"s09","startFrame":1530,"endFrame":1585,"text":"Cache-Reads kosten nur 25 Cent"},
    {"id":"c30","sceneId":"scene5","sentenceId":"s09","startFrame":1585,"endFrame":1635,"text":"pro Million Tokens."},
    {"id":"c31","sceneId":"scene5","sentenceId":"s10","startFrame":1635,"endFrame":1695,"text":"Anthropic schätzt, dass typische Workloads"},
    {"id":"c32","sceneId":"scene5","sentenceId":"s10","startFrame":1695,"endFrame":1755,"text":"dadurch ungefähr 25 Prozent"},
    {"id":"c33","sceneId":"scene5","sentenceId":"s10","startFrame":1755,"endFrame":1800,"text":"günstiger werden können."},
    {"id":"c34","sceneId":"scene5","sentenceId":"s11","startFrame":1800,"endFrame":1845,"text":"Für normale Nutzer heißt das:"},
    {"id":"c35","sceneId":"scene5","sentenceId":"s11","startFrame":1845,"endFrame":1890,"text":"Du bekommst sehr viel"},
    {"id":"c36","sceneId":"scene5","sentenceId":"s11","startFrame":1890,"endFrame":1920,"text":"von der Mythos-Intelligenz,"},
    {"id":"c37","sceneId":"scene5","sentenceId":"s11","startFrame":1920,"endFrame":1950,"text":"aber nicht jeden Spezialmodus."}
  ]
}
