{
  "version": 1,
  "fps": 30,
  "cues": [
    {"sceneId":"hallucination-01","startFrame":0,"endFrame":65,"text":"Eine KI kann sicher klingen"},
    {"sceneId":"hallucination-01","startFrame":65,"endFrame":130,"text":"und trotzdem etwas erfinden."},
    {"sceneId":"hallucination-01","startFrame":130,"endFrame":195,"text":"Genau deshalb wirken manche falschen Antworten"},
    {"sceneId":"hallucination-01","startFrame":195,"endFrame":259,"text":"erstaunlich glaubwürdig."},
    
    {"sceneId":"hallucination-02","startFrame":259,"endFrame":345,"text":"Ein Sprachmodell sucht keine fertige Antwort nach."},
    {"sceneId":"hallucination-02","startFrame":345,"endFrame":431,"text":"Es berechnet Schritt für Schritt,"},
    {"sceneId":"hallucination-02","startFrame":431,"endFrame":518,"text":"welcher Textbaustein wahrscheinlich als Nächstes passt."},
    
    {"sceneId":"hallucination-03","startFrame":518,"endFrame":604,"text":"Das Problem: sprachliche Sicherheit ist kein Wahrheitsbeweis."},
    {"sceneId":"hallucination-03","startFrame":604,"endFrame":690,"text":"Eine perfekt formulierte Antwort"},
    {"sceneId":"hallucination-03","startFrame":690,"endFrame":777,"text":"kann fachlich trotzdem falsch sein."},
    
    {"sceneId":"hallucination-04","startFrame":777,"endFrame":863,"text":"Passende Quellen helfen."},
    {"sceneId":"hallucination-04","startFrame":863,"endFrame":949,"text":"Das Modell bekommt gezielten Kontext"},
    {"sceneId":"hallucination-04","startFrame":949,"endFrame":1036,"text":"und muss weniger aus allgemeinen Mustern ergänzen."},
    
    {"sceneId":"hallucination-05","startFrame":1036,"endFrame":1122,"text":"Bei wichtigen Fakten gilt trotzdem:"},
    {"sceneId":"hallucination-05","startFrame":1122,"endFrame":1208,"text":"Quelle öffnen, Zahl kontrollieren, Aussage prüfen."},
    {"sceneId":"hallucination-05","startFrame":1208,"endFrame":1295,"text":"Gute KI-Nutzung heißt gezielt verifizieren."}
  ]
}
