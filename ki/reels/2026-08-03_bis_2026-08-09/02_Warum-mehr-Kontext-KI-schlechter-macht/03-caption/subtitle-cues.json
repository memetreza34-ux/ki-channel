{
  "version": 1,
  "fps": 30,
  "cues": [
    {"sceneId":"context-overload-01","startFrame":0,"endFrame":76,"text":"Du gibst einer KI mehr Kontext –"},
    {"sceneId":"context-overload-01","startFrame":76,"endFrame":152,"text":"und die Antwort wird trotzdem schlechter?"},
    {"sceneId":"context-overload-01","startFrame":152,"endFrame":230,"text":"Genau das kann passieren."},
    {"sceneId":"context-overload-02","startFrame":230,"endFrame":306,"text":"Im Kontext sind nicht alle Informationen gleich wichtig."},
    {"sceneId":"context-overload-02","startFrame":306,"endFrame":382,"text":"Starke Beziehungen tragen die Antwort,"},
    {"sceneId":"context-overload-02","startFrame":382,"endFrame":461,"text":"schwache Details sollten weniger Gewicht bekommen."},
    {"sceneId":"context-overload-03","startFrame":461,"endFrame":537,"text":"Gute Systeme laden deshalb nicht alles."},
    {"sceneId":"context-overload-03","startFrame":537,"endFrame":613,"text":"Sie holen gezielt nur Quellen,"},
    {"sceneId":"context-overload-03","startFrame":613,"endFrame":692,"text":"die zur aktuellen Frage passen."},
    {"sceneId":"context-overload-04","startFrame":692,"endFrame":768,"text":"Dann fliegen unpassende Informationen raus."},
    {"sceneId":"context-overload-04","startFrame":768,"endFrame":844,"text":"Relevante Fakten bleiben übrig"},
    {"sceneId":"context-overload-04","startFrame":844,"endFrame":923,"text":"und werden zu einem klaren Kern verdichtet."},
    {"sceneId":"context-overload-05","startFrame":923,"endFrame":1000,"text":"Mehr Kontext ist nicht automatisch besser."},
    {"sceneId":"context-overload-05","startFrame":1000,"endFrame":1077,"text":"Besser ist: auswählen, verdichten"},
    {"sceneId":"context-overload-05","startFrame":1077,"endFrame":1154,"text":"und erst dann die Antwort erzeugen."}
  ]
}
