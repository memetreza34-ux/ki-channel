{
  "name": "ki-channel",
  "version": "0.1.0",
  "private": true,
  "description": "Produktionssystem für den deutschen faceless KI-Kanal mit Remotion",
  "engines": {
    "node": ">=20 <21"
  },
  "workspaces": [
    "core",
    "ki"
  ],
  "scripts": {
    "repo:wiring-check": "node scripts/check-repository-wiring.mjs",
    "ki:reel:structure-check": "node scripts/check-ki-reel-folder-structure.mjs",
    "ki:longform:structure-check": "node scripts/check-ki-longform-folder-structure.mjs",
    "test": "npm run repo:wiring-check && npm run ki:reel:structure-check && npm run ki:longform:structure-check && vitest run",
    "typecheck:motion": "tsc --noEmit -p ki/tsconfig.motion.json",
    "typecheck:animation-library": "tsc --noEmit -p ki/tsconfig.animation-library.json",
    "typecheck": "npm run typecheck:motion && npm run typecheck:animation-library",
    "typecheck:all": "npm run typecheck",
    "content:runtime:verify": "node scripts/verify-content-matched-runtime.mjs",
    "repo:verify": "npm run repo:wiring-check && npm run typecheck && npm test && npm run content:runtime:verify",
    "release:verify": "node scripts/run-content-release.mjs verify",
    "release:smoke": "node scripts/run-content-release.mjs smoke",
    "release:full": "node scripts/run-content-release.mjs full",
    "new-video": "node scripts/new-ki-reel.mjs",
    "new-longform": "node scripts/new-ki-longform.mjs",
    "motion:script-check": "node --check scripts/motion-render-config.mjs && node --check scripts/motion-source-fingerprint.mjs && node --check scripts/motion-artifact-validation.mjs && node --check scripts/motion-release-summary.mjs && node --check scripts/render-motion-system.mjs && node --check scripts/check-motion-renders.mjs && node --check scripts/combine-motion-release-reports.mjs && node --check scripts/why-ai-reel-config.mjs && node --check scripts/render-why-ai-reel.mjs && node --check scripts/check-why-ai-reel.mjs && node --check scripts/__tests__/motion-source-fingerprint.test.mjs && node --check scripts/__tests__/motion-artifact-validation.test.mjs && node --check scripts/__tests__/motion-release-summary.test.mjs && node --check scripts/__tests__/why-ai-reel-config.test.mjs",
    "motion:node-test": "node --test scripts/__tests__/motion-source-fingerprint.test.mjs scripts/__tests__/motion-artifact-validation.test.mjs scripts/__tests__/motion-release-summary.test.mjs scripts/__tests__/why-ai-reel-config.test.mjs",
    "motion:test": "vitest run ki/src/motion-system/__tests__ ki/src/reels/why-ai-reads-differently/__tests__ && npm run motion:node-test",
    "motion:typecheck": "tsc --noEmit -p ki/tsconfig.motion.json",
    "motion:verify": "npm run motion:script-check && npm run motion:test && npm run motion:typecheck && npm run motion:render-plan",
    "motion:smoke": "node scripts/render-motion-system.mjs smoke",
    "motion:timeline-smoke": "node scripts/render-motion-system.mjs timeline-smoke",
    "motion:release-check": "npm run motion:verify && npm run motion:smoke && npm run motion:timeline-smoke",
    "motion:render-plan": "node scripts/render-motion-system.mjs plan",
    "motion:render-stills": "node scripts/render-motion-system.mjs stills",
    "motion:render-videos": "node scripts/render-motion-system.mjs videos",
    "motion:render-all": "node scripts/render-motion-system.mjs all",
    "motion:timeline-render": "node scripts/render-motion-system.mjs timeline",
    "motion:check-stills": "node scripts/check-motion-renders.mjs stills",
    "motion:check-videos": "node scripts/check-motion-renders.mjs videos",
    "motion:check-renders": "node scripts/check-motion-renders.mjs all",
    "motion:check-timeline": "node scripts/check-motion-renders.mjs timeline",
    "motion:check-release": "node scripts/combine-motion-release-reports.mjs",
    "motion:full-release-check": "npm run motion:verify && npm run motion:render-all && npm run motion:check-renders && npm run motion:timeline-render && npm run motion:check-timeline && npm run motion:check-release",
    "reel:why-ai:test": "vitest run ki/src/reels/why-ai-reads-differently/__tests__",
    "reel:why-ai:plan": "node scripts/render-why-ai-reel.mjs plan",
    "reel:why-ai:smoke": "node scripts/render-why-ai-reel.mjs smoke",
    "reel:why-ai:stills": "node scripts/render-why-ai-reel.mjs stills",
    "reel:why-ai:video": "node scripts/render-why-ai-reel.mjs video",
    "reel:why-ai:render": "node scripts/render-why-ai-reel.mjs all",
    "reel:why-ai:check": "node scripts/check-why-ai-reel.mjs",
    "reel:why-ai:verify": "npm run motion:script-check && npm run reel:why-ai:test && npm run motion:node-test && npm run motion:typecheck && npm run reel:why-ai:plan",
    "reel:why-ai:full-release-check": "npm run reel:why-ai:verify && npm run reel:why-ai:render && npm run reel:why-ai:check",
    "animation-library:verify": "node scripts/verify-animation-library.mjs",
    "animation-library:plan": "node scripts/render-animation-library.mjs plan",
    "animation-library:smoke": "node scripts/render-animation-library.mjs smoke",
    "animation-library:stills": "node scripts/render-animation-library.mjs stills",
    "animation-library:videos": "node scripts/render-animation-library.mjs videos",
    "animation-library:render": "node scripts/render-animation-library.mjs all",
    "animation-library:check": "node scripts/check-animation-library-renders.mjs",
    "animation-library:full-release-check": "npm run animation-library:verify && npm run animation-library:render && npm run animation-library:check",
    "animation-library:expanded:verify": "node scripts/verify-expanded-animation-library.mjs",
    "animation-library:expanded:plan": "node scripts/render-expanded-animation-library.mjs plan",
    "animation-library:expanded:smoke": "node scripts/render-expanded-animation-library.mjs smoke",
    "animation-library:expanded:stills": "node scripts/render-expanded-animation-library.mjs stills",
    "animation-library:expanded:videos": "node scripts/render-expanded-animation-library.mjs videos",
    "animation-library:expanded:render": "node scripts/render-expanded-animation-library.mjs all",
    "animation-library:expanded:check": "node scripts/check-expanded-animation-library-renders.mjs",
    "animation-library:expanded:full-release-check": "npm run animation-library:expanded:verify && npm run animation-library:expanded:render && npm run animation-library:expanded:check",
    "animation-library:maximal:verify": "node scripts/verify-maximal-animation-library.mjs",
    "animation-library:maximal:plan": "node scripts/render-maximal-animation-library.mjs plan",
    "animation-library:maximal:smoke": "node scripts/render-maximal-animation-library.mjs smoke",
    "animation-library:maximal:stills": "node scripts/render-maximal-animation-library.mjs stills",
    "animation-library:maximal:videos": "node scripts/render-maximal-animation-library.mjs videos",
    "animation-library:maximal:render": "node scripts/render-maximal-animation-library.mjs all",
    "animation-library:maximal:check": "node scripts/check-maximal-animation-library-renders.mjs",
    "animation-library:maximal:full-release-check": "npm run animation-library:maximal:verify && npm run animation-library:maximal:render && npm run animation-library:maximal:check",
    "animation-library:ultimate:verify": "node scripts/verify-ultimate-animation-library.mjs",
    "animation-library:ultimate:plan": "node scripts/render-ultimate-animation-library.mjs plan",
    "animation-library:ultimate:smoke": "node scripts/render-ultimate-animation-library.mjs smoke",
    "animation-library:ultimate:stills": "node scripts/render-ultimate-animation-library.mjs stills",
    "animation-library:ultimate:videos": "node scripts/render-ultimate-animation-library.mjs videos",
    "animation-library:ultimate:render": "node scripts/render-ultimate-animation-library.mjs all",
    "animation-library:ultimate:check": "node scripts/check-ultimate-animation-library-renders.mjs",
    "animation-library:ultimate:full-release-check": "npm run animation-library:ultimate:verify && npm run animation-library:ultimate:render && npm run animation-library:ultimate:check",
    "micro-motion:verify": "node scripts/verify-micro-motions.mjs",
    "micro-motion:plan": "node scripts/render-micro-motions.mjs plan",
    "micro-motion:smoke": "node scripts/render-micro-motions.mjs smoke",
    "micro-motion:stills": "node scripts/render-micro-motions.mjs stills",
    "micro-motion:videos": "node scripts/render-micro-motions.mjs videos",
    "micro-motion:render": "node scripts/render-micro-motions.mjs all",
    "micro-motion:check": "node scripts/check-micro-motion-renders.mjs",
    "micro-motion:full-release-check": "npm run micro-motion:verify && npm run micro-motion:render && npm run micro-motion:check",
    "bits:find": "npx -y remotion-bits find",
    "bits:fetch": "npx -y remotion-bits fetch",
    "bits:mcp": "npx -y remotion-bits mcp"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/captions": "4.0.488",
    "@remotion/cli": "4.0.488",
    "@remotion/google-fonts": "4.0.488",
    "@remotion/layout-utils": "4.0.488",
    "@remotion/light-leaks": "4.0.488",
    "@remotion/lottie": "4.0.488",
    "@remotion/media-utils": "4.0.488",
    "@remotion/motion-blur": "4.0.488",
    "@remotion/noise": "4.0.488",
    "@remotion/paths": "4.0.488",
    "@remotion/rive": "4.0.488",
    "@remotion/shapes": "4.0.488",
    "@remotion/three": "4.0.488",
    "@remotion/transitions": "4.0.488",
    "@rive-app/canvas-advanced": "^2.38.3",
    "country-flag-icons": "^1.6.20",
    "culori": "^4.0.2",
    "gsap": "3.15.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "remotion": "4.0.488",
    "rough-notation": "0.5.1",
    "roughjs": "4.6.6",
    "sharp": "^0.33.5",
    "three": "^0.171.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/install-whisper-cpp": "4.0.488",
    "@types/culori": "^4.0.1",
    "@types/react": "^18.2.0",
    "@types/three": "^0.171.0",
    "typescript": "^5.0.0",
    "vitest": "4.1.10"
  }
}
