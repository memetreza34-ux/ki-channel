  "editorial": {"targetDurationSeconds":{"min":58,"max":70},"targetScriptWords":{"min":125,"max":145},"targetSceneCount":{"min":8,"max":9},"sentencesPerScene":2,"finalDurationRule":"speech end plus 1.2 to 2.2 seconds","maximumLeadInSeconds":0.6,"forbidArtificialPadding":true},
  "audio": {"sourceGenerationSpeed":1,"defaultPlaybackRate":1,"maximumPlaybackRateWithoutExplicitApproval":1.05,"preservePitch":true,"music":false,"soundEffects":"off","timingSource":"timeline/final-sync.json generated from final voiceover","estimatedTimingMayBeUsedInFinalRender":false},
  "sync": {"requiredFinalFile":"timeline/final-sync.json","singleSourceOfTruth":true,"wordTimingsRequired":true,"maximumSemanticTriggerOffsetFrames":5,"maximumSceneBoundaryOffsetFrames":6,"maximumCaptionStartDelayFrames":3,"fallbackTimingAllowedAfterFinalAudio":false,"compositionDurationDerivedFromSpeech":true},
  "captions": {"mode":"dual-sentence-active-word","sentencesVisible":2,"fullTextVisibleImmediately":true,"activeWordColor":"violet","inactiveWordColor":"white","wordByWordRevealAllowed":false,"wordSizeChangeAllowed":false,"progressIndicatorAllowed":false,"defaultFontSizePx":44,"minimumFontSizePx":42,"bottomPx":{"min":245,"max":285},"largeBackgroundBoxAllowed":false,"timingSource":"real word start and end frames"},
  "visual": {"format":{"width":1080,"height":1920,"fps":30},"reelSceneStrategy":"100-percent deterministic Remotion animation","generatedSceneImagesAllowed":false,"stockSceneImagesAllowed":false,"primaryObjectsPerScene":1,"maximumSupportingElementsPerScene":2,"primaryVisualAreaPercent":{"min":60,"max":78},"dominantMotionsPerScene":1,"maximumStrongSimultaneousMotions":2,"maximumSemanticBeatsPerScene":3,"minimumReadableResultHoldSeconds":1,"miniDashboardsAllowed":false,"tinyLabelsAsPrimaryExplanationAllowed":false,"repeatedFullChoreographyAllowed":false,"persistentSceneNumbersAllowed":false,"persistentKickersAllowed":false,"decorativeConstantMotionAllowed":false,"phoneReadabilityRequired":true},
  "semanticCoverage": {"requireBeatMapBeforeCoding":true,"beatMapShape":"meaning phrase -> visual reaction -> transcript trigger -> result state","importantMeaningWithoutVisualReactionAllowed":false,"fillerWordsReceiveStrongAnimation":false,"maximumBeatsPerScene":3},
  "releaseRequires": ["final audio","real word transcript","valid timeline/final-sync.json","two caption sentences per scene","violet active-word tracking","no progress line","no active fallback timing","trigger offset validation","scene boundary validation","typecheck","focused tests","animation director review","visual QA agent review","current checkpoints","contact sheet review","full current MP4","normal-speed phone-size watch","technical artifact validation","user approval"],
  "canonicalHumanStandard": "FUTURE-REEL-STANDARD.md"
