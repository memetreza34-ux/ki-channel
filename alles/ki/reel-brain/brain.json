{
  "version": 5,
  "standardId": "ki-animation-only-reel-v3",
  "mission": "Premium German AI reels whose final scene timing, semantic motion and two-sentence karaoke captions are driven by the real voiceover transcript.",
  "appliesTo": "all newly created reels",
  "historicalStandardIds": ["ki-animation-only-reel-v1", "ki-animation-only-reel-v2"],
